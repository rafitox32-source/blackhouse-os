{
  "name": "app-de-rafitox",
  "version": "1.2.0",
  "main": "main.js",
  "author": "J.P",
  "description": "Sistema de Gestión Profesional",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.blackhouse.os",
    "productName": "BlackHouse OS",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "license": "licencia.txt"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rafitox32-source",
        "repo": "blackhouse-os",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      ".env",
      "!dist/*",
      "!**/*.ts",
      "!*.map",
      "!.git/*",
      "!icono/**/*",
      "!Firmware/**/*",
      "!Dump/**/*"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^9.0.1",
    "openai": "^6.44.0",
    "png-to-ico": "^3.0.1"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "semantic-release": "^22.0.12",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6"
  }
}
