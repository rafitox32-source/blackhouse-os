{
  "name": "app-de-rafitox",
  "version": "1.0.0",
  "main": "main.js",
  "author": "J.P",
  "description": "Sistema de Gestión Profesional",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.rafitox.app",
    "productName": "BlackHouse OS",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "license": "licencia.txt"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!**/*.ts",
      "!*.map"
    ]
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "electron-updater": "^6.8.9",
    "sqlite3": "^5.1.7"
  }
}
